{
  "version": 3,
  "overrides": {
    "jasa/index.html": {
      "path": "jasa"
    },
    "artikel/index.html": {
      "path": "artikel"
    },
    "tentang-kami/index.html": {
      "path": "tentang-kami"
    },
    "kontak/index.html": {
      "path": "kontak"
    },
    "index.html": {
      "path": ""
    },
    "galeri/index.html": {
      "path": "galeri"
    },
    "produk/lainnya/index.html": {
      "path": "produk/lainnya"
    },
    "produk/belt-conveyor/index.html": {
      "path": "produk/belt-conveyor"
    }
  },
  "routes": [
    {
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      },
      "src": "/_nuxt/builds/meta/(.*)"
    },
    {
      "headers": {
        "cache-control": "public, max-age=1, immutable"
      },
      "src": "/_nuxt/builds/(.*)"
    },
    {
      "headers": {
        "X-Robots-Tag": "noindex"
      },
      "src": "/_nuxt"
    },
    {
      "headers": {
        "cache-control": "public, max-age=31536000, immutable",
        "X-Robots-Tag": "noindex"
      },
      "src": "/_nuxt/(.*)"
    },
    {
      "src": "/_nuxt/builds/meta(.*)",
      "headers": {
        "cache-control": "public,max-age=31536000,immutable"
      },
      "continue": true
    },
    {
      "src": "/_nuxt/builds(.*)",
      "headers": {
        "cache-control": "public,max-age=31536000,immutable"
      },
      "continue": true
    },
    {
      "src": "/_nuxt(.*)",
      "headers": {
        "cache-control": "public,max-age=31536000,immutable"
      },
      "continue": true
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "(?<__isr_route>/__nuxt_error)",
      "dest": "/__fallback"
    },
    {
      "src": "/sitemap.xml",
      "dest": "/sitemap.xml"
    },
    {
      "src": "/robots.txt",
      "dest": "/robots.txt"
    },
    {
      "src": "/admin/produk",
      "dest": "/admin/produk"
    },
    {
      "src": "/admin/login",
      "dest": "/admin/login"
    },
    {
      "src": "/admin/kategori",
      "dest": "/admin/kategori"
    },
    {
      "src": "/admin/jasa",
      "dest": "/admin/jasa"
    },
    {
      "src": "/admin/industri",
      "dest": "/admin/industri"
    },
    {
      "src": "/admin/galeri",
      "dest": "/admin/galeri"
    },
    {
      "src": "/admin/artikel",
      "dest": "/admin/artikel"
    },
    {
      "src": "/admin",
      "dest": "/admin"
    },
    {
      "src": "/__sitemap__/urls",
      "dest": "/__sitemap__/urls"
    },
    {
      "src": "/__sitemap__/style.xsl",
      "dest": "/__sitemap__/style.xsl"
    },
    {
      "src": "/__nuxt_error",
      "dest": "/__nuxt_error"
    },
    {
      "src": "/produk/lainnya/(?<kategori>[^/]+)",
      "dest": "/produk/lainnya/[kategori]"
    },
    {
      "src": "/produk/belt-conveyor/(?<kategori>[^/]+)",
      "dest": "/produk/belt-conveyor/[kategori]"
    },
    {
      "src": "/produk/(?<slug>[^/]+)",
      "dest": "/produk/[slug]"
    },
    {
      "src": "/jasa/(?<slug>[^/]+)",
      "dest": "/jasa/[slug]"
    },
    {
      "src": "/artikel/(?<slug>[^/]+)",
      "dest": "/artikel/[slug]"
    },
    {
      "src": "/admin/produk/(?<id>[^/]+)",
      "dest": "/admin/produk/[id]"
    },
    {
      "src": "/admin/jasa/(?<id>[^/]+)",
      "dest": "/admin/jasa/[id]"
    },
    {
      "src": "/admin/industri/(?<id>[^/]+)",
      "dest": "/admin/industri/[id]"
    },
    {
      "src": "/admin/galeri/(?<id>[^/]+)",
      "dest": "/admin/galeri/[id]"
    },
    {
      "src": "/admin/artikel/(?<id>[^/]+)",
      "dest": "/admin/artikel/[id]"
    },
    {
      "src": "/__nuxt_island/(?:.*)",
      "dest": "/__nuxt_island/[...]"
    },
    {
      "src": "/(.*)",
      "dest": "/__fallback"
    }
  ]
}